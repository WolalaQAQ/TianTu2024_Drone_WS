<?xml version="1.0"?>
<launch>
  <!-- Robot Decision -->
  <!-- 加载YAML文件中的参数 -->
  <rosparam file="$(find uav_decision)/params/params.yaml" command="load"/>
  <node pkg="ttauav_node" type="uavdata" name="uavdata" />
  <node pkg="ttauav_node" type="service" name="service" output="screen" />
  <include file="$(find many_rect_detector)/launch/many_rect_detector_node.launch"/>
  <node pkg="uav_decision" type="uav_decision_node" name="uav_decision" output="screen">
    <param name="/speed" type ="double" value="0.1"/>
    <param name="/fly_time" type ="double" value="300"/>
    <param name="/map_north_angle" type ="double" value="0"/>
    <param name="/Kp" type="double" value = "0.001"/>

    <param name="/x_offset" value = "-13"/>
    <param name="/y_offset" value = "102"/>
  </node>

</launch>
