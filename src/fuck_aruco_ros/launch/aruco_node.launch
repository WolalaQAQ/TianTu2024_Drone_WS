<?xml version="1.0"?>
<launch>
  <!-- Aruco Node -->
  <node pkg="fuck_aruco_ros" type="aruco_node" name="aruco_node" output="screen">
    <param name="image_topic" value="/uav_cam_node/image_raw"/>

    <param name="use_resolve" value="false"/>

    <param name="camera_info_topic" value="/uav_cam_node/camera_info"/>
    <param name="camera_frame" value="camera_link"/>
    <param name="marked_image_topic" value="/aruco_node/marked_image"/>
    <param name="marker_pose_topic" value="/aruco_node/marker_pose"/>
    <param name="marker_point_topic" value="/aruco_node/marker_point"/>
    <param name="marker_length" type="double" value="0.13"/>

  </node>

</launch>