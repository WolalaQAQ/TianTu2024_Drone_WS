<launch>

    <!-- Start the uavdata server -->
    <node pkg="ttauav_node" type="uavdata" name="uavdata" />
    <node pkg="ttauav_node" type="service" name="service" output="screen" />
    <node pkg="ttauav_node" type="uav_decision" name="uav_decision" output="screen">
        <param name="/vel_n" type="double" value="0.5" />
        <param name="/fly_time" type="double" value="11284" />
        <param name="X_axis_offset" type="int" value="1" />
        <param name="Y_axis_offset" type="int" value="97" />
        <param name="/track_threshold" type="double" value="0.04" />
        <param name="/Kp" type="double" value="0.0012" />
        <param name="/Time_delay" type="double" value="8" />
        <param name="/track_time" type="int" value="120" />
        <param name="/landing_threshold" type="double" value="0.05" />
    </node>
  
  
  </launch>
  
